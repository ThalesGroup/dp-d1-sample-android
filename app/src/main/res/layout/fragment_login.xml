<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/banking_background"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        style="@style/BankingScreenContent"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                style="@style/BankingHeaderContainer"
                android:paddingTop="0dp"
                android:paddingBottom="24dp"
                android:transitionName="banking_page_header">
                <ImageView
                    android:id="@+id/logo"
                    style="@style/BankingHeaderLogo" />
                <TextView
                    style="@style/BankingHeaderTitle"
                    android:text="@string/login_title" />
                <TextView
                    style="@style/BankingHeaderDescription"
                    android:labelFor="@id/consumer_id_input"
                    android:text="@string/login_subtitle" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/consumer_id_layout"
                style="@style/BankingDropdownLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/consumer_id">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/consumer_id_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="none"
                    android:cursorVisible="false"
                    android:textColor="@color/banking_text"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/login_button"
                style="@style/BankingBottomAction"
                android:layout_marginTop="24dp"
                android:text="@string/login" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
