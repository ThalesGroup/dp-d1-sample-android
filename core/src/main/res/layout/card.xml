<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="com.thalesgroup.d1.templates.core.ui.base.CardPresentation" />
        <variable name="mViewModel"
            type="com.thalesgroup.d1.templates.core.ui.base.CardViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.thalesgroup.d1.templates.core.ui.CardFrameLayout
            android:id="@+id/card_holder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/card_outline"
            android:clipToOutline="true"
            app:layout_constraintDimensionRatio="H,337:212"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_card_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@{mViewModel.mCardBackground != null ? mViewModel.mCardBackground : @drawable/card_placeholder, default=@drawable/card_placeholder}"
                android:importantForAccessibility="no" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rl_card_wrap_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="20dp">
                <TextView
                    android:id="@+id/tv_pan"
                    style="@style/BankingCardPan.Reference"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:text="@{CardPresentation.pan(mViewModel.mMaskedPan)}"
                    android:textColor="@{mViewModel.mCardBackground != null ? @color/white : @color/card_placeholder_text}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/card_security_details"
                    app:layout_constraintVertical_bias="0.8" />
                <!-- The SDK combined artwork includes the scheme at bottom right. -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/scheme_artwork_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.65" />
                <LinearLayout
                    android:id="@+id/card_security_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/scheme_artwork_start"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            style="@style/TextView.Emboss.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@{mViewModel.mCardBackground != null ? @color/white : @color/card_placeholder_label}"
                            android:text="@string/card_label_valid_thru" />
                        <TextView
                            android:id="@+id/tv_exp"
                            style="@style/TextView.Emboss.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textDirection="ltr"
                            android:textColor="@{mViewModel.mCardBackground != null ? @color/white : @color/card_placeholder_text}"
                            android:text="@{CardPresentation.expiry(mViewModel.mExpr)}" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="28dp"
                        android:orientation="vertical"
                        android:visibility="@{mViewModel.mD1PushDefaultVisibility, default=gone}">
                        <TextView
                            style="@style/TextView.Emboss.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@{mViewModel.mCardBackground != null ? @color/white : @color/card_placeholder_label}"
                            android:text="@string/wallet" />
                        <TextView
                            style="@style/BankingCardName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@{mViewModel.mCardBackground != null ? @color/white : @color/card_placeholder_text}"
                            android:text="@{mViewModel.mWallet}" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ProgressBar
                android:id="@+id/pb_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="@{mViewModel.mProgressVisibility}" />
        </com.thalesgroup.d1.templates.core.ui.CardFrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
