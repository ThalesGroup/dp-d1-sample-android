<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.TextView" parent="Base.TextAppearance.AppCompat">
        <item name="android:textColor">@color/banking_text</item>
        <item name="colorControlNormal">@color/banking_blue</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="AppTheme.Button" parent="BankingButton" />

    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/banking_blue</item>
        <item name="colorAccent">@color/banking_blue</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/banking_text</item>
        <item name="android:textColorSecondary">@color/banking_secondary</item>
    </style>

    <style name="AppTheme.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColor">@color/banking_text</item>
        <item name="android:textColorHint">@color/banking_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="colorPrimary">@color/banking_blue</item>
    </style>

    <!-- High-contrast card details, matching the TSH sample card. -->
    <style name="TextView.Emboss" parent="AppTheme.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">32sp</item>
        <item name="android:shadowRadius">0</item>
    </style>
    <style name="TextView.Emboss.Small" parent="AppTheme.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="TextView.Emboss.Label" parent="AppTheme.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
