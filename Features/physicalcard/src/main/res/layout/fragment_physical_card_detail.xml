<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/banking_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout style="@style/BankingScreenContent">
        <LinearLayout style="@style/BankingCompactHeaderContainer"
            android:transitionName="banking_page_header">
            <TextView
                style="@style/BankingCompactHeaderTitle"
                android:text="@string/physical_card_services_title" />
            <TextView
                style="@style/BankingCompactHeaderDescription"
                android:text="@string/physical_card_services_subtitle" />
        </LinearLayout>

        <View style="@style/BankingDivider" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/activate_card_button"
            style="@style/BankingActionRow"
            android:drawableStart="@drawable/banking_ic_activate"
            android:text="@string/activate_card" />

        <View style="@style/BankingDivider" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/display_pin_button"
            style="@style/BankingActionRow"
            android:drawableStart="@drawable/banking_ic_pin"
            android:text="@string/display_pin" />

        <View style="@style/BankingDivider" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/change_pin_button"
            style="@style/BankingActionRow"
            android:drawableStart="@drawable/banking_ic_change_pin"
            android:text="@string/change_pin" />

        <View style="@style/BankingDivider" />
    </LinearLayout>
</ScrollView>
