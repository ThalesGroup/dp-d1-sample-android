<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/banking_background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout style="@style/BankingScreenContent">
            <LinearLayout style="@style/BankingCompactHeaderContainer"
                android:transitionName="banking_page_header">
                <TextView
                    style="@style/BankingCompactHeaderTitle"
                    android:text="@string/activate_my_card" />
                <TextView
                    style="@style/BankingCompactHeaderDescription"
                    android:text="@string/activation_description" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_activation_text"
                style="@style/BankingBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" />
            <!-- Keep the SDK secure field and its existing reveal lifecycle. -->
            <com.thalesgroup.gemalto.d1.SecureEditText
                android:id="@+id/ste_activation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:visibility="invisible" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout style="@style/BankingActionFooter">
        <View style="@style/BankingDivider" />
        <Button
            android:id="@+id/bt_activate_card"
            style="@style/BankingBottomAction"
            android:text="@string/activate_card" />
    </LinearLayout>
</LinearLayout>
