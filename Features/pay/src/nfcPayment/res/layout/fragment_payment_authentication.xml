<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">
    <TextView
        style="@style/BankingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/authenticate_to_proceed"
        android:textSize="22sp" />
    <ImageView
        android:id="@+id/fpImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_phone_pos"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/tv_amount_currency"
        style="@style/BankingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="28sp" />
    <View style="@style/BankingDivider" />
    <Button
        android:id="@+id/btn_authenticate"
        style="@style/BankingPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/authenticate"
        android:visibility="visible" />
</LinearLayout>
