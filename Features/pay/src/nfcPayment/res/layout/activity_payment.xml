<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/banking_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout style="@style/BankingScreenContent">
            <LinearLayout style="@style/BankingCompactHeaderContainer"
                android:transitionName="banking_page_header">
                <TextView
                    style="@style/BankingCompactHeaderTitle"
                    android:text="@string/banking_payment_title" />
                <TextView
                    style="@style/BankingCompactHeaderDescription"
                    android:text="@string/banking_payment_description" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <include
                    android:id="@+id/view_card"
                    layout="@layout/card" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/payment_sdk_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/banking_secondary" />
</LinearLayout>
