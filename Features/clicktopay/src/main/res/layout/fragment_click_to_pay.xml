<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/banking_background">
    <LinearLayout style="@style/BankingScreenContent"
        android:paddingBottom="0dp">
        <LinearLayout style="@style/BankingCompactHeaderContainer"
            android:transitionName="banking_page_header">
            <TextView
                style="@style/BankingCompactHeaderTitle"
                android:text="@string/c2p_title" />
            <TextView
                android:id="@+id/tv_c2p_subtitle"
                style="@style/BankingCompactHeaderDescription"
                android:text="@string/c2p_not_enrolled_subtitle" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="26" android:hint="@string/c2p_cardholder_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_cardholder_name" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName" android:maxLength="26" android:text="Nesera Navalto" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/BankingSection"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/c2p_consumer_info" />
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="30" android:hint="@string/c2p_first_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_first_name" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName" android:maxLength="30" android:text="Nesera" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="30" android:hint="@string/c2p_middle_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_middle_name" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName" android:maxLength="30" android:text="Ihned" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="30" android:hint="@string/c2p_last_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_last_name" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName" android:maxLength="30" android:text="Navalto" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:hint="@string/c2p_language">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_language" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:text="it-IT" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="10" android:hint="@string/c2p_phone_country_code">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_phone_country_code" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="phone" android:maxLength="10" android:text="+39" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="14" android:hint="@string/c2p_phone_number">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_phone_number" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="phone" android:maxLength="14" android:text="698989898" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="255" android:hint="@string/c2p_email">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_email" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textEmailAddress" android:maxLength="255" android:text="neser@naval.to" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/BankingSection"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/c2p_billing_address" />
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:hint="@string/c2p_country_code">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_country_code" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapCharacters" android:text="IT" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="64" android:hint="@string/c2p_address_line1">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_line1" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPostalAddress" android:maxLength="64" android:text="Via Roma 1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="64" android:hint="@string/c2p_address_line2">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_line2" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPostalAddress" android:maxLength="64" android:text="" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="64" android:hint="@string/c2p_address_line3">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_line3" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPostalAddress" android:maxLength="64" android:text="" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="32" android:hint="@string/c2p_city">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_city" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:maxLength="32" android:text="Rome" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:counterEnabled="true" app:counterMaxLength="3" android:hint="@string/c2p_state">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_state" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:maxLength="3" android:text="RM" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/BankingInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            app:counterEnabled="true" app:counterMaxLength="10" android:hint="@string/c2p_zip_code">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_zip_code" style="@style/BankingInputText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:maxLength="10" android:text="00100" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <Button android:id="@+id/btn_c2p_enroll" style="@style/BankingPrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/c2p_btn_enroll" />
            <Button android:id="@+id/btn_c2p_update" style="@style/BankingSecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/c2p_btn_update" />
            <Button android:id="@+id/btn_c2p_optout" style="@style/BankingDestructiveButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:text="@string/c2p_btn_optout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
