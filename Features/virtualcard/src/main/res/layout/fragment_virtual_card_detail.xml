<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.text.TextUtils" />
        <import type="com.thalesgroup.d1.templates.core.ui.base.CardPresentation" />
        <variable name="mViewModel"
            type="com.thalesgroup.d1.templates.virtualcard.ui.virtualcarddetail.VirtualCardDetailViewModel" />
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/card_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">
            <com.thalesgroup.d1.templates.core.ui.CardFrameLayout
                android:id="@+id/card_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/card_outline">
                <ImageView
                    android:id="@+id/card_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/card_placeholder"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_wrap_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="20dp">
                    <com.thalesgroup.gemalto.d1.DisplayTextView
                        android:id="@+id/tv_card_name"
                        style="@style/BankingCardName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="12dp"
                        android:textColor="@{mViewModel.cardBackground != null ? @color/white : @color/card_placeholder_text}"
                        android:text="@{mViewModel.mCardName}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/scheme_artwork_start"
                        app:layout_constraintTop_toTopOf="parent" />
                    <com.thalesgroup.gemalto.d1.DisplayTextView
                        android:id="@+id/tv_pan"
                        style="@style/VirtualCardPan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layoutDirection="ltr"
                        android:textDirection="ltr"
                        android:textColor="@{mViewModel.cardBackground != null ? @color/white : @color/card_placeholder_text}"
                        android:text="@{CardPresentation.pan(mViewModel.mPan)}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/card_security_details"
                        app:layout_constraintVertical_bias="0.8" />
                    <!-- Leave the SDK's embedded scheme artwork unobstructed. -->
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/scheme_artwork_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.65" />
                    <LinearLayout
                        android:id="@+id/card_security_details"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/scheme_artwork_start"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/TextView.Emboss.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@{mViewModel.cardBackground != null ? @color/white : @color/card_placeholder_label}"
                                android:text="@string/card_label_valid_thru" />
                            <com.thalesgroup.gemalto.d1.DisplayTextView
                                android:id="@+id/tv_exp"
                                style="@style/TextView.Emboss.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textDirection="ltr"
                                android:textColor="@{mViewModel.cardBackground != null ? @color/white : @color/card_placeholder_text}"
                                android:text="@{CardPresentation.expiry(mViewModel.mExpr)}" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/TextView.Emboss.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@{mViewModel.cardBackground != null ? @color/white : @color/card_placeholder_label}"
                                android:text="@string/card_label_cvv" />
                            <com.thalesgroup.gemalto.d1.DisplayTextView
                                android:id="@+id/tv_cvv"
                                style="@style/TextView.Emboss.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textDirection="ltr"
                                android:textColor="@{mViewModel.cardBackground != null ? @color/white : @color/card_placeholder_text}"
                                android:text="@{TextUtils.isEmpty(mViewModel.mCvv) ? `•••` : mViewModel.mCvv}" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.thalesgroup.d1.templates.core.ui.CardFrameLayout>
        </FrameLayout>
        <ProgressBar
            android:id="@+id/pb_card_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</layout>
